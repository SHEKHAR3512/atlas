# =============================================
# APPLICATION
# =============================================

APP_NAME=ATLAS
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# =============================================
# DATABASE
# =============================================

POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_local
DATABASE_URL=postgresql+psycopg://atlas:atlas_local@postgres:5432/atlas
# Local standalone fallback: sqlite+aiosqlite:///atlas.db
SQLITE_FALLBACK=true

REDIS_URL=redis://redis:6379/0

# =============================================
# TRADING
# =============================================

TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACK=

BASE_CURRENCY=INR
INITIAL_PAPER_CAPITAL=100000

MARKET=NSE
TIMEZONE=Asia/Kolkata

# =============================================
# RISK
# =============================================

KELLY_FRACTION=0.25

MAX_POSITION_PCT=0.03
MAX_SECTOR_EXPOSURE_PCT=0.15
MAX_GROSS_EXPOSURE_PCT=0.60

MAX_DAILY_LOSS_PCT=0.015
MAX_WEEKLY_LOSS_PCT=0.04
MAX_PORTFOLIO_DRAWDOWN_PCT=0.08

MAX_CORRELATED_POSITIONS=3

MIN_BACKTEST_TRADES=100

MAX_ORDER_NOTIONAL_PCT=0.03
MAX_SLIPPAGE_BPS=20

ALLOW_SHORTS=false
ALLOW_MARGIN=false
ALLOW_FUTURES=false
ALLOW_OPTIONS=false
ALLOW_LEVERAGE=false

HARD_KILL_SWITCH=true

# =============================================
# BROKER
# =============================================

BROKER=paper

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# =============================================
# AI
# =============================================

AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# =============================================
# MONITORING
# =============================================

PROMETHEUS_ENABLED=true
